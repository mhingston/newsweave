DATABASE_URL=postgres://user:password@127.0.0.1:5432/newsweave
MINIFLUX_URL=http://127.0.0.1:8080
MINIFLUX_API_TOKEN=replace-me
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=replace-me
AI_MODEL=muse-spark-1.2-contributor-free
RESEND_API_KEY=replace-me
EMAIL_FROM=Newsweave <news@example.com>
EMAIL_TO=you@example.com
TIMEZONE=Europe/London
PUBLICATION_TIME=06:00
RETENTION_DAYS=7
FABRIC_BIN=fabric
YTDLP_BIN=yt-dlp
RETRY_MAX_ATTEMPTS=3
# Use feed IDs or exact feed titles, comma-separated.
FANOUT_FEED_TITLES=Ben's Bites
# Feeds where each entry is individually tested for digest shape before fan-out:
# at least FANOUT_MIN_LINKS outbound links across FANOUT_MIN_DOMAINS distinct domains.
# Entries that do not qualify stay ordinary RSS items. Feeds not listed here are never heuristic fan-outs.
#FANOUT_CANDIDATE_FEED_IDS=165,167
#FANOUT_CANDIDATE_FEED_TITLES=
#FANOUT_MIN_LINKS=5
#FANOUT_MIN_DOMAINS=3

# Optional typed decision layer. Disabled by default.
# When enabled, Newsweave re-ranks story groups and can merge cross-source
# groups that a System One-compatible model judges to be the same event.
#DECISION_MODEL_ENABLED=false
#DECISION_MODEL_DEDUPE_ENABLED=true
#DECISION_MODEL_DUPLICATE_THRESHOLD=0.85
#DECISION_MODEL_TIMEOUT_MS=30000
#DECISION_MODEL_RUN_BUDGET_MS=60000
#DECISION_EDITORIAL_POLICY=Prioritize substantive, novel, consequential information with concrete mechanisms, evidence, implementation detail, or decisions the reader can act on.

# @mhingston5/jev-cli provider configuration. See the jev-cli README for
# TypeSafe, OpenRouter, Vercel, Cloudflare, and custom /v1/systemone providers.
#JEV_PROVIDER=typesafe
#JEV_MODEL=jev-1.13.0
#TYPESAFE_API_KEY=replace-me
# For a local/custom System One-compatible provider:
#JEV_PROVIDER=custom
#JEV_ENDPOINT=http://localhost:8000/v1/systemone
#JEV_API_KEY=
