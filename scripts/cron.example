# Newsweave scheduled commands (install only after building with `npm run build`).
# Adjust the log directory and node path for the host.

# Poll Miniflux and process newly discovered items hourly.
0 * * * * cd /opt/newsweave && mkdir -p logs && /usr/bin/node dist/cli.js ingest >> logs/ingest.log 2>&1
5 * * * * cd /opt/newsweave && mkdir -p logs && /usr/bin/node dist/cli.js process >> logs/process.log 2>&1

# Publish the local Europe/London digest at 06:00.
0 6 * * * cd /opt/newsweave && mkdir -p logs && /usr/bin/node dist/cli.js publish >> logs/publish.log 2>&1

# Remove all items and provenance older than the configured retention window.
30 6 * * * cd /opt/newsweave && mkdir -p logs && /usr/bin/node dist/cli.js retention >> logs/retention.log 2>&1
