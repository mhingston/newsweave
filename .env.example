DATABASE_URL=postgres://user:password@127.0.0.1:5432/newsweave
MINIFLUX_URL=http://127.0.0.1:8080
MINIFLUX_API_TOKEN=replace-me
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=replace-me
AI_MODEL=deepseek-v4-flash
RESEND_API_KEY=replace-me
EMAIL_FROM=Newsweave <news@example.com>
EMAIL_TO=you@example.com
TIMEZONE=Europe/London
PUBLICATION_TIME=06:00
RETENTION_DAYS=7
FABRIC_BIN=fabric
YTDLP_BIN=yt-dlp
RETRY_MAX_ATTEMPTS=3
# Use feed IDs or exact feed titles, comma-separated.
FANOUT_FEED_TITLES=Ben's Bites
# Feeds where each entry is individually tested for digest shape before fan-out:
# at least FANOUT_MIN_LINKS outbound links across FANOUT_MIN_DOMAINS distinct domains.
# Entries that do not qualify stay ordinary RSS items. Feeds not listed here are never heuristic fan-outs.
#FANOUT_CANDIDATE_FEED_IDS=165,167
#FANOUT_CANDIDATE_FEED_TITLES=
#FANOUT_MIN_LINKS=5
#FANOUT_MIN_DOMAINS=3
